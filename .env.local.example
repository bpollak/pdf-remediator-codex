# Copy to .env.local for local development.

# Optional local-by-default in development:
# If omitted, /api/verapdf will default to http://127.0.0.1:8081
# VERAPDF_SERVICE_URL=http://127.0.0.1:8081

# Optional; defaults to ua1.
VERAPDF_VALIDATION_PROFILE=ua1

# Optional auth if your veraPDF REST service is protected.
# VERAPDF_SERVICE_TOKEN=replace-me
# VERAPDF_SERVICE_API_KEY=replace-me

# Optional timeout in milliseconds; defaults to 120000.
# VERAPDF_TIMEOUT_MS=120000

# Optional TritonAI LiteLLM gateway for AI-assisted alt-text suggestions.
# LITELLM_API_KEY=your-tritonai-api-key
# LITELLM_BASE_URL=https://tritonai-api.ucsd.edu
# LITELLM_MODEL=gpt-5.5
# LITELLM_FALLBACK_MODELS=api-mistral-small-3.2-2506,api-gemma-4-26b

# Optional TritonAI OCR override. If omitted, OCR uses LITELLM_API_KEY and the default model below.
# OCR_LITELLM_API_KEY=your-on-prem-tritonai-api-key
# OCR_LITELLM_BASE_URL=https://tritonai-api.ucsd.edu
# OCR_LITELLM_MODEL=api-mistral-small-3.2-2506
# OCR_LITELLM_FALLBACK_MODELS=api-gemma-4-26b
