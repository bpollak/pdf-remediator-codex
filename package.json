{
  "name": "accessible-pdf",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9 <23"
  },
  "scripts": {
    "predev": "node scripts/copy-pdf-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-pdf-worker.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:pdf-agent": "vitest run tests/pdf-accessibility-agent.regression.test.ts",
    "test:release-gate": "vitest run tests/pdf-accessibility-agent.regression.test.ts tests/public-fixtures-regression.test.ts tests/pipeline.integration.test.ts tests/remediate-builder.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config playwright.live.config.ts",
    "verapdf:up": "bash ./scripts/verapdf-local.sh up",
    "verapdf:down": "bash ./scripts/verapdf-local.sh down",
    "verapdf:status": "bash ./scripts/verapdf-local.sh status",
    "verapdf:smoke": "bash ./scripts/verapdf-local.sh smoke"
  },
  "dependencies": {
    "next": "15.5.28",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.5.136",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tesseract.js": "^5.1.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.3",
    "fake-indexeddb": "^6.2.6",
    "postcss": "^8.4.39",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
